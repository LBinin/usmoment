{
  "name": "@usmoment/workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter @usmoment/docs-site build",
    "build:web": "pnpm --filter @usmoment/playground-web build",
    "changeset:status": "pnpm changeset status",
    "dev:docs": "pnpm --filter @usmoment/docs-site dev",
    "dev:taro": "pnpm --filter @usmoment/playground-taro build",
    "dev:web": "pnpm --filter @usmoment/playground-web dev",
    "test": "pnpm -r test",
    "test:headless": "pnpm --filter @usmoment/headless test",
    "test:web": "pnpm --filter @usmoment/playground-web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.10",
    "vitest": "^3.1.2"
  }
}
