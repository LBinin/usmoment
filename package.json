{
  "name": "@usmoment/workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @usmoment/taro build",
    "build:docs": "pnpm --filter @usmoment/docs-site build",
    "build:web": "pnpm --filter @usmoment/playground-web build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "changeset:status": "pnpm changeset status",
    "dev:docs": "pnpm --filter @usmoment/docs-site dev",
    "dev:taro": "pnpm --filter @usmoment/taro build && pnpm --filter @usmoment/showcase-taro dev",
    "dev:taro:facade": "pnpm --filter @usmoment/taro dev",
    "dev:taro:all": "pnpm --filter @usmoment/taro build && pnpm --parallel --filter @usmoment/taro --filter @usmoment/showcase-taro dev",
    "dev:showcase-taro": "pnpm --filter @usmoment/taro build && pnpm --filter @usmoment/showcase-taro dev",
    "build:showcase-taro": "pnpm --filter @usmoment/taro build && pnpm --filter @usmoment/showcase-taro build",
    "dev:sync-taro-consumer": "node scripts/sync-taro-consumer.mjs",
    "dev:web": "pnpm --filter @usmoment/playground-web dev",
    "test": "pnpm -r test",
    "test:headless": "pnpm --filter @usmoment/headless test",
    "test:web": "pnpm --filter @usmoment/playground-web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "release:changeset": "pnpm changeset",
    "release:status": "pnpm changeset status --verbose",
    "release:version": "pnpm changeset version",
    "release:pack": "pnpm --dir packages/facades/taro pack --pack-destination ../../../dist-pack",
    "release:pack:dry": "pnpm --dir packages/facades/taro exec npm pack --dry-run",
    "release:smoke": "node scripts/smoke-taro-package.mjs",
    "release:check": "pnpm check:architecture && pnpm test && pnpm typecheck && pnpm build && pnpm lint && pnpm release:pack:dry && pnpm release:smoke",
    "release:publish": "node scripts/publish-release.mjs",
    "release:alpha:enter": "pnpm changeset pre enter alpha",
    "release:beta:enter": "pnpm changeset pre enter beta",
    "release:rc:enter": "pnpm changeset pre enter rc",
    "release:pre:exit": "pnpm changeset pre exit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@tarojs/components": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@tsdown/css": "0.21.10",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "0.21.10",
    "typescript": "^5.8.3",
    "vite": "^7.1.10",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
