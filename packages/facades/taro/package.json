{
  "name": "@usmoment/taro",
  "version": "0.0.1-alpha.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBinin/usmoment.git",
    "directory": "packages/facades/taro"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsdown && node ../../../scripts/clean-taro-dist.mjs",
    "dev": "tsdown --watch --no-clean --on-success \"node ../../../scripts/clean-taro-dist.mjs\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@tarojs/components": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
